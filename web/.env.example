# Same project as the desktop app's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (never the service_role key)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# Web Push VAPID public key for reminders while browser tab is closed
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<from scripts/web/gen-vapid-keys.mjs>

