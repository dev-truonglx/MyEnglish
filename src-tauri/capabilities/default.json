{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: all plugins and every app command",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "notification:default",
    "updater:default",
    "process:default",
    "autostart:default",
    "allow-show-main-window",
    "allow-enrich-word-with-gemini",
    "allow-generate-grammar-exercises-ai",
    "allow-generate-vocabulary-recommendations-ai",
    "allow-check-cli-status",
    "allow-send-desktop-notification",
    "allow-trigger-review-navigation",
    "allow-show-review-popup",
    "allow-hide-review-popup",
    "allow-show-review-nudge",
    "allow-hide-review-nudge",
    "allow-is-cursor-over-nudge",
    "allow-take-review-nudge-payload",
    "allow-prepare-update-exit",
    "allow-cancel-update-exit",
    "allow-get-popup-blockers",
    "allow-log-debug",
    "allow-set-tray-due-count",
    "allow-export-backup",
    "allow-grade-sentence-ai",
    "allow-correct-writing-ai",
    "allow-generate-memory-aid-ai",
    "allow-compute-fsrs-parameters"
  ]
}
