{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyEnglish",
  "version": "0.0.12",
  "identifier": "com.myenglish.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MyEnglish Dashboard",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "quick-input",
        "title": "MyEnglish Quick Input",
        "width": 640,
        "height": 118,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "review-popup",
        "title": "MyEnglish Focus Review",
        "width": 1920,
        "height": 1080,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "review-nudge",
        "title": "MyEnglish Reminder",
        "width": 380,
        "height": 132,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxMjE1MURGNUE3OEY0NzAKUldSdzlIaGEzMUVoSVUxSGxic3pZMDEyNzRpajJqQ0JSYkZPbHdJSHFVS2hhMGViOGl0RHlhUUMK",
      "endpoints": [
        "https://github.com/dev-truonglx/MyEnglish/releases/latest/download/latest.json"
      ]
    }
  }
}
